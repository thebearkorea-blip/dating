# 키 이름만 둔다. 값은 .env.local에 (커밋 금지).
AI_GATEWAY_API_KEY=
# 이미지 공급자 fal(LoRA 학습·추론, src/img/fal.ts). 값은 .env.local에만
FAL_KEY=
ANTHROPIC_API_KEY=
# LLM 2단 테스트: RUN_LLM_TESTS=1 로 켠다(키 필요)
RUN_LLM_TESTS=
# 공급자 강제: mock|anthropic|gateway. 로컬은 mock(키가 있어도 mock).
LLM_PROVIDER=
# Web Push: node --import tsx src/tools/vapid.ts 로 생성(.env.local에만 둔다)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Vercel Cron 인증(/api/cron/proactive)
CRON_SECRET=
# Neon(Vercel Marketplace). 있으면 PGlite 대신 Neon을 쓴다. 마이그레이션은 UNPOOLED 권장
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Clerk(Vercel Marketplace)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# 무료 상업 스톡 Pexels(src/tools/stock-fetch.ts). https://www.pexels.com/api/ 에서 무료 발급, 값은 .env.local에만
PEXELS_API_KEY=
